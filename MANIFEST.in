include requirements*.txt build_release.ps1 *.spec start_ezDIC.bat start_Capture.bat
include .github/workflows/ci.yml
recursive-include docs *.md *.json *.txt *.cff *.csv
recursive-include paper *.md *.bib *.png *.svg *.py *.pdf *.json
recursive-include tests *.py
recursive-include schemas *.json
recursive-include benchmarks *.json
recursive-include assets/validation *.png
recursive-include assets/ui *.png
