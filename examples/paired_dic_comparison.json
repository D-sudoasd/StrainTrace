      "rows_representation": "partial_rows",
      "columns": {
        "x": "x", "y": "y", "u": "u", "v": "v",
        "strain_xx": "exx", "strain_yy": "eyy", "strain_xy": "exy",
        "eligible": "eligible", "correlation_valid": "valid", "strain_valid": "strain_valid",
        "quality": "sigma"
      },
      "quality": {"name": "VIC sigma", "unit": "px", "meaning": "REPLACE_WITH_DEFINITION_FOR_THE_EXPORTED_VIC_VERSION"}
