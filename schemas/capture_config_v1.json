{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/D-sudoasd/StrainTrace/schemas/capture_config_v1.json",
  "title": "StrainTrace Capture configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["config_version", "name", "cameras", "phases"],
  "properties": {
    "config_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "cameras": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": {"type": "string", "pattern": "^[^:]+:.+"},
          "settings": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}}
        }
      }
    },
    "phases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/phase"}},
    "queue_capacity": {"oneOf": [{"type": "integer", "minimum": 1}, {"const": "auto"}], "default": "auto"},
    "max_buffer_bytes": {"type": "integer", "minimum": 1, "default": 268435456},
    "min_free_bytes": {"type": "integer", "minimum": 0, "default": 268435456},
    "durability": {"enum": ["buffered", "write_through"], "default": "buffered"},
    "segment_frames": {"type": "integer", "minimum": 0, "default": 0},
    "cti_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "calibration_files": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "quality_regions": {
      "type": "object",
      "propertyNames": {"pattern": "^[^:]+:.+"},
      "additionalProperties": {"$ref": "#/$defs/quality_region"}
    },
    "metadata": {"type": "object"}
  },
  "$defs": {
    "quality_region": {
      "type": "object",
      "required": ["bounds", "image_size_px", "pixel_format", "significant_bits"],
      "additionalProperties": false,
      "properties": {
        "bounds": {
          "type": "array", "minItems": 4, "items": false,
          "prefixItems": [
            {"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0},
            {"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}
          ]
        },
        "image_size_px": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "pixel_format": {"type": "string", "minLength": 1},
        "significant_bits": {"type": "integer", "minimum": 1, "maximum": 16},
        "image_part": {"type": ["string", "null"], "minLength": 1},
        "sensor_window": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "offset_x": {"type": "integer", "minimum": 0}, "offset_y": {"type": "integer", "minimum": 0},
            "binning_x": {"type": "integer", "minimum": 1}, "binning_y": {"type": "integer", "minimum": 1},
            "decimation_x": {"type": "integer", "minimum": 1}, "decimation_y": {"type": "integer", "minimum": 1}
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["single", "timed", "continuous", "manual", "hardware", "event"]},
        "role": {"enum": ["reference", "test", "calibration"], "default": "test"},
        "frame_count": {"type": "integer", "minimum": 1},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "frame_timeout_s": {"type": "number", "exclusiveMinimum": 0, "default": 3},
        "hardware_source": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
          ]
        },
        "hardware_pairing": {"$ref": "#/$defs/hardware_pairing"},
        "monitor_trigger_wait": {"type": "boolean"},
        "start_confirmation": {"type": "string", "pattern": "\\S", "description": "Operator instructions to display before the phase can arm or start."},
        "software_trigger_fallback": {"type": "boolean", "default": false},
        "pre_frames": {"type": "integer", "minimum": 0},
        "post_frames": {"type": "integer", "minimum": 1},
        "event_count": {"type": "integer", "minimum": 0, "default": 1, "description": "Finish after this many event windows. Zero monitors until duration or stop."},
        "overlap_events": {"type": "boolean", "default": false},
        "csv_trigger": {"$ref": "#/$defs/csv_trigger"}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "timed"}}},
          "then": {"required": ["fps"], "anyOf": [{"required": ["frame_count"]}, {"required": ["duration_s"]}]}
        },
        {
          "if": {"properties": {"mode": {"const": "event"}}},
          "then": {"required": ["fps", "post_frames"], "not": {"required": ["frame_count"]}},
          "else": {"not": {"anyOf": [{"required": ["pre_frames"]}, {"required": ["post_frames"]}, {"required": ["csv_trigger"]}, {"required": ["event_count"]}, {"required": ["overlap_events"]}]}}
        },
        {
          "if": {"properties": {"mode": {"const": "hardware"}}},
          "then": {"required": ["hardware_source"]},
          "else": {"not": {"anyOf": [{"required": ["hardware_source"]}, {"required": ["hardware_pairing"]}, {"required": ["monitor_trigger_wait"]}]}}
        },
        {
          "if": {"properties": {"mode": {"const": "single"}}},
          "then": {"properties": {"frame_count": {"const": 1}}, "not": {"required": ["duration_s"]}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["single", "continuous", "manual", "hardware"]}}},
          "then": {"not": {"required": ["fps"]}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["continuous", "hardware"]}}},
          "then": {"not": {"required": ["software_trigger_fallback"]}}
        }
      ]
    },
    "csv_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "value_column", "threshold", "direction", "quantity", "unit"],
      "properties": {
        "path": {"type": "string", "pattern": "\\S"},
        "value_column": {"type": "string", "pattern": "\\S"},
        "threshold": {"type": "number", "minimum": -1.7976931348623157e308, "maximum": 1.7976931348623157e308},
        "direction": {"enum": ["rising", "falling"]},
        "quantity": {"type": "string", "pattern": "\\S"},
        "unit": {"type": "string", "pattern": "\\S"},
        "time_column": {"type": "string", "pattern": "\\S"},
        "header_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "hardware_pairing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "counter_feature", "first_counter"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "counter_feature": {"enum": ["ChunkCounterValue", "ChunkFramecounter", "ChunkFrameID"]},
        "first_counter": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 0}},
        "first_event_number": {"type": "integer", "minimum": 0, "default": 1}
      }
    }
  }
}
